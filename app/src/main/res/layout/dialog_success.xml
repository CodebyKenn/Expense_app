<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/p2_bg_white_card"
    android:padding="20dp"
    android:minWidth="300dp">

    <!-- TOP ROW: TITLE & X CLOSE BUTTON -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notification"
            android:textColor="#46044B"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCloseX"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#7651A8"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- CHECKMARK CIRCLE -->
    <TextView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/p2_bg_circle"
        android:backgroundTint="#46044B"
        android:gravity="center"
        android:text="✓"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- MESSAGE TEXT -->
    <TextView
        android:id="@+id/tvDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Action completed successfully."
        android:textColor="#46044B"
        android:textSize="15sp"
        android:layout_marginBottom="20dp" />

    <!-- DONE / CLOSE BUTTON -->
    <Button
        android:id="@+id/btnDialogDone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_button_purple"
        android:backgroundTint="@null"
        android:text="Close"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:stateListAnimator="@null" />

</LinearLayout>
